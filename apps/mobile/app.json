{
  "expo": {
    "name": "AgroTraders",
    "slug": "agrostock",
    "version": "0.2.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "agrotraders",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B3D2E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agrotraders.org",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.agrotraders.org",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#178E4B"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-build-properties",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-image-picker",
        {
          "photosPermission": "AgroTraders needs access to your photo library so you can attach product images, your profile photo, vehicle and equipment photos, and KYC verification documents.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#178E4B"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3ee3e712-ea7d-4a74-972e-cbeb6b625399"
      }
    },
    "owner": "influencioads"
  }
}
